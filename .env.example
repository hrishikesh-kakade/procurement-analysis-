ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-32+chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
# First admin, created on startup only when the users table is empty
ADMIN_EMAIL=admin@procurement-platform.dev
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173

# Optional services (leave empty to run without them)
REDIS_URL=
QDRANT_URL=
# AI assistant + RAG answers. Without a key, deterministic fallbacks are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# hashing (offline, lexical) or fastembed (semantic; pip install -r requirements-ml.txt)
EMBEDDING_BACKEND=hashing
